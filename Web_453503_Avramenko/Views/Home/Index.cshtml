@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>
    <title>Index</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Web_453503_Avramenko.styles.css" asp-append-version="true"/>
</head>
<body>
    <header>
        <div class="container">
            <nav class="navbar bg-dark navbar-expand-md border-bottom border-body"
                 data-bs-theme="dark">
            <!-- меню сайта -->
            <a class="navbar-brand" href="#">45350001</a>
            <div class="navbar-nav">
                <a class="nav-item nav-link active" href="#">Лб 1</a>
                <a class="nav-item nav-link" href="#">Каталог</a>
                <a class="nav-item nav-link" href="#">Администрирование</a>
            </div>
            <!-- меню сайта - конец -->
            <!-- Информация пользователя -->
            <a href="#" class="navbar-text ms-auto">
                00,0 руб <i class="bi bi-cart"></i> (0)
            </a>
            <div class="dropdown ms-4 nav-color">
                <button class="btn btn-secondary dropdown-toggle"
                        type="button" id="dropdownMenuButton"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                    User@gmail.com
                    <img src="images/default-profile-picture.jpeg" width="30"
                         alt="User" class="rounded nav-color" />
                </button>
                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                <li>
                <span class="dropdown-item-text">
                    <img src="images/default-profile-picture.jpeg"
                         width="50" alt="User" class="rounded" />
                    user@gmail.com
                </span>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form id="logoutForm" class="form-inline">
                        <button id="logout" type="submit" class="nav-link
    btn btn-link">Logout</button>
                    </form>
                </li>
                </ul>
            </div>
            <!-- Информация пользователя - конец -->
            </nav> <!-- Панель навигации - конец -->
        </div><!-- container - конец -->
    </header><!-- header - конец -->
    <main class="container">
        <h1 class="mt-4">Лабораторная Работа 1</h1>

        <h2 class="mt-4">Список</h2>
        <ol type="A" class="list-group mt-4 ps-4">
            <li>Первый элемент списка</li>
            <li>Второй элемент списка</li>
            <li>Третий элемент списка</li>
        </ol>

        <hr class="my-4" />
        
        <h2 class="mt-4">Форма</h2>
        <form class="mb-5" method="post">
            <div class="mb-3">
                <div class="form-check offset-md-2">
                    <input class="form-check-input" type="checkbox"
                           name="checkBox1" id="checkBox1"/>
                    <label class="form-check-label" for="checkBox1">
                        Чек-бокс-1
                    </label>
                </div>
                <div class="form-check offset-md-2">
                    <input class="form-check-input" type="checkbox"
                           name="checkBox2" id="checkBox2"/>
                    <label class="form-check-label" for="checkBox1">
                        Чек-бокс-2
                    </label>
                </div>
            </div>
            
            <fieldset class="mb-3">
                <div class="form-check form-check-inline offset-md-2">
                    <input class="form-check-input" type="radio"
                           name="radio" id="radio1" value="1" checked/>
                    <label class="form-check-label" for="radio1">Радио-1</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio"
                           name="radio" id="radio2" value="2"/>
                    <label class="form-check-label" for="radio2">Радио-2</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio"
                           name="radio" id="radio3" value="3"/>
                    <label class="form-check-label" for="radio3">Радио-3</label>
                </div>
            </fieldset>
            
            <div class="row mb-3">
                <label for="login" class="col-md-2 col-form-label">Логин</label>
                <div class="col-md-10">
                    <input type="text" class="form-control" id="login"
                           name="login" placeholder="Введите логин"/>
                </div>
            </div>

            <div class="row mb-3">
                <label for="password" class="col-md-2 form-label">Пароль</label>
                <div class="col-md-10">
                    <input type="password" class="form-control" id="password"
                           name="password" placeholder="Введите пароль"/>
                </div>
            </div>
            

            <button type="submit" class="btn btn-primary">Отправить</button>
        </form>
    </main>
    <footer>
        <div class="container">
            <div class="navbar bg-dark navbar-expand-md border-bottom border-body"
                 data-bs-theme="dark">
                <div class="navbar-nav ms-auto">
                    <a class="nav-item nav-link" href="http://www.facebook.com">
                        <i class="bi bi-facebook" style="font-size: 2rem"></i>
                    </a>
                    <a class="nav-item nav-link" href="http://www.vk.com">
                        <i class="bi bi-twitter" style="font-size: 2rem"></i>
                    </a>
                    <a class="nav-item nav-link" href="http://www.x.com">
                        <i class="bi-telegram" style="font-size: 2rem"></i>
                    </a>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>