@page
@model Web_453503_Avramenko.UI.Areas.Admin.Pages.IndexModel

@{
    ViewData["Title"] = "Index";

    var prev = Model.Pet.CurrentPage == 1
        ? 1
        : Model.Pet.CurrentPage - 1;
    var next = Model.Pet.CurrentPage == Model.Pet.TotalPages
        ? Model.Pet.TotalPages
        : Model.Pet.CurrentPage + 1;
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Pet.Items[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pet.Items[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pet.Items[0].Weight)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pet.Items[0].Image)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pet.Items[0].Species)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Pet.Items) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Weight)
            </td>
            <td>
                <img src="@item.Image"
                     class="card-img-top"
                     alt="Image of @item.Name"
                     style="height: 250px; object-fit: cover;">
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Species.Name)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<nav class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item">
            <a class="page-link"
               href="?pageNumber=@prev">
                Prev
            </a>
        </li>

        @for (var pageNumber = 1; pageNumber <= Model.Pet.TotalPages; pageNumber++)
        {
            <li class="page-item @(pageNumber == Model.Pet.CurrentPage ? "active" : string.Empty)">
                <a class="page-link"
                href="?pageNumber=@pageNumber">
                    @pageNumber
                </a>
            </li>
        }

        <li class="page-item">
            <a class="page-link"
               href="?pageNumber=@next">
                Next
            </a>
        </li>
    </ul>
</nav>
