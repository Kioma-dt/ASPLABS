@page
@model Web_453503_Avramenko.UI.Areas.Admin.Pages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Pet</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Pet.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Pet.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Pet.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Pet.Description)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Pet.Weight)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Pet.Weight)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Pet.Image)
        </dt>
        <dd class="col-sm-10">
            <img src="@Model.Pet.Image"
                 class="card-img-top"
                 alt="Image of @Model.Pet.Name"
                 style="height: 250px; object-fit: cover;">
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Pet.Species)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Pet.Species.Name)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Pet.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
