@page "/counter/{InitialCount:int?}"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @_currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

<EditForm Model="@_counterModel" OnValidSubmit="SetCount">
    <DataAnnotationsValidator />
    <ValidationSummary />
    
    <div class="mt-3">
        <label>Start Value: </label>
        
        <InputNumber class="form-control"
                     @bind-Value="_counterModel.Counter"/>
        
        <button type="submit" class="btn btn-success mt-2">
            Set
        </button>
    </div>
</EditForm>

@code {
    private int _currentCount = 0;
    
    private readonly CounterModel _counterModel = new();
    
    [Parameter]
    public int? InitialCount { get; set; }

    protected override void OnParametersSet()
    {
        if (InitialCount >= 0)
        {
            _currentCount = InitialCount.Value;
            _counterModel.Counter =  _currentCount;
        }
    }

    private void IncrementCount()
    {
        _currentCount++;
    }

    private void SetCount()
    {
        _currentCount = _counterModel.Counter;
    }
    
    private class CounterModel
    {
        [Range(1, 10, ErrorMessage = "Value for {0} must be between {1} and {2}.")]
        public int Counter { get; set; }
    }
}