@page "/pets"
@attribute [Authorize]

@inject IDataService DataService
@using Web_453503.Domain.Entities
@implements IDisposable

<PageTitle>Pets</PageTitle>

<h1>Pets list</h1>

@if (_isLoading)
{
    <p>Loading...</p>
}
else
{
    <SpeciesSelector />
    <PetList PetSelected="OnPetSelected" />
    <Pager CategoryName="@DataService.SelectedSpecies?.NormalizedName" />
    <PetDetails SelectedPet="@SelectedPet" />
}

@code {
    private bool _isLoading = true;
    
    private Pet? SelectedPet { get; set; }

    protected override async Task OnInitializedAsync()
    {
        DataService.DataLoaded += OnDataLoaded;
        
        await DataService.GetSpeciesListAsync();

        if (DataService.Success)
        {
            await DataService.GetPetsListAsync();   
        }

        _isLoading = false;
    }
    
    private void OnPetSelected(Guid id)
    {
        SelectedPet = DataService.Pets
            .FirstOrDefault(p => p.Id == id);
    }

    private void OnDataLoaded()
    {
        SelectedPet = null;

        StateHasChanged();
    }
    
    public void Dispose()
    {
        DataService.DataLoaded -= OnDataLoaded;
    }
}