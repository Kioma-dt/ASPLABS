@inject IDataService DataService
@implements IDisposable

@if (DataService.TotalPages > 1)
{
    <nav aria-label="Pagination">
        <ul class="pagination">

            <li class="page-item @(DataService.CurrentPage == 1 ? "disabled" : "")">
                <button class="page-link"
                        disabled="@(DataService.CurrentPage == 1)"
                        @onclick="() => SelectPageAsync(DataService.CurrentPage - 1)">
                    &laquo;
                </button>
            </li>

            @for (int i = 1; i <= DataService.TotalPages; i++)
            {
                var page = i;

                <li class="page-item @(DataService.CurrentPage == page ? "active" : "")">
                    <button class="page-link"
                            @onclick="() => SelectPageAsync(page)">
                        @(page.ToString())
                    </button>
                </li>
            }

            <li class="page-item @(DataService.CurrentPage == DataService.TotalPages ? "disabled" : "")">
                <button class="page-link"
                        disabled="@(DataService.CurrentPage == DataService.TotalPages)"
                        @onclick="() => SelectPageAsync(DataService.CurrentPage + 1)">
                    &raquo;
                </button>
            </li>

        </ul>
    </nav>
}

@code {
    [Parameter]
    public string? CategoryName { get; set; }

    protected override void OnInitialized()
    {
        DataService.DataLoaded += StateHasChanged;
    }

    private async Task SelectPageAsync(int page)
    {
        if (page < 1 || page > DataService.TotalPages
                     || page == DataService.CurrentPage)
        {
            return;
        }

        await DataService.GetPetsListAsync(page);
    }

    public void Dispose()
    {
        DataService.DataLoaded -= StateHasChanged;
    }
}