@inject IDataService DataService
@implements IDisposable

@if (!DataService.Success)
{
    <div class="alert alert-danger">
        @DataService.ErrorMessage
    </div>
}
else if (DataService.Pets.Count == 0)
{
    <p>Pets list is empty</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th></th>
        </tr>
        </thead>

        <tbody>
        @foreach (var pet in DataService.Pets)
        {
            <tr @key="pet.Id">
                <td>@pet.Name</td>
                <td>@pet.Description</td>
                <td>
                    <button class="btn btn-outline-primary btn-sm"
                            title="Details"
                            aria-label="Details"
                            @onclick="() => PetSelected.InvokeAsync(pet.Id)">
                        <i class="bi bi-info-circle"></i>
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public EventCallback<Guid> PetSelected { get; set; }
    
    protected override void OnInitialized()
    {
        DataService.DataLoaded += StateHasChanged;
    }

    public void Dispose()
    {
        DataService.DataLoaded -= StateHasChanged;
    }
}